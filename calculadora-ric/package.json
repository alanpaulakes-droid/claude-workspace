{
  "name": "calculadora-ric",
  "version": "4.0.0",
  "private": true,
  "description": "Calculadora RIC Domiciliaria: cálculo, simulador 3D y enseñanza según los pliegos RIC (SEC, Chile). Se compila a un solo HTML.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/engine tests scripts",
    "format": "prettier --write \"src/engine/**/*.ts\" \"tests/unit/**/*.ts\" \"scripts/**/*.mjs\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/engine/**/*.ts\" \"tests/unit/**/*.ts\" \"scripts/**/*.mjs\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^2.1.9"
  }
}
